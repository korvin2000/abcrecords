# Vorlage fuer frontend/.env.local (nicht versioniert).
#
# ACHTUNG: Diese Variablen gelten nur fuer den EIGENSTAENDIGEN Betrieb
# (`npm run dev`, `npm run build`). Wird das Guestbook in eine Host-Anwendung
# eingebunden, gehoeren die Umgebungsvariablen dieser Host-Anwendung — die
# API-URL wird dann als Prop uebergeben:
#
#     <Guestbook config={{ apiBaseUrl: '/gbook/api' }} />
#
# siehe docs/guestbook-integration.md, Abschnitt 8.

# Basis-URL der REST-API, wie sie der Browser sieht.
# Muss zu API_BASE_PATH im Backend passen.
# Alternativ VITE_GUESTBOOK_API_BASE_URL — die wird zuerst gelesen und ist
# gedacht fuer Host-Anwendungen, die VITE_API_BASE_URL schon selbst belegen.
VITE_API_BASE_URL=/gbook/api

# Ziel des Entwicklungs-Proxys (nur fuer `npm run dev` relevant).
VITE_PROXY_TARGET=https://www.domain.com
