{
  "name": "demoscene-workspace",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Workspace holding @site/demoscene (the integrable feature package) and a dev host that stands in for the encyclopedia SPA.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @site/dev-host",
    "build": "npm run build --workspace @site/dev-host",
    "build:standalone": "npm run build:standalone --workspace @site/dev-host",
    "preview": "npm run preview --workspace @site/dev-host",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "plates": "npm run plates --workspace @site/dev-host"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
